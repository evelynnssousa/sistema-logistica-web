{
  "name": "sistema-logistica-web",
  "version": "1.0.0",
  "description": "Sistema de Serviços de Logística e Manutenção",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "tsx watch backend/src/server.ts",
    "auth:create-admin": "npm run build:backend && node backend/dist/cli/create-initial-admin.js",
    "test:backend": "npm run build:backend && node --test backend/test/*.test.cjs",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run build:frontend && npm run build:backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelynnssousa/sistema-logistica-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/evelynnssousa/sistema-logistica-web/issues"
  },
  "homepage": "https://github.com/evelynnssousa/sistema-logistica-web#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
