# Copie para backend/.env apenas quando houver valores de ambiente autorizados.
# Substitua os placeholders localmente; nao salve credenciais neste arquivo.
# Confira com: npm run config:check (mostra so nomes e situacao, nunca valores).
# Producao: veja docs/PRODUCAO.md.
# Homologacao: NAO use este arquivo. Defina o segredo do Codespaces SLM_HOMOLOG_DATABASE_URL
# e use npm run homolog (docs/auditoria/PREPARACAO_HOMOLOGACAO_2026-11-06.md).
PORT=3000
FRONTEND_URL=http://localhost:5173

# Nao inclua sslmode na URL: o TLS e configurado em backend/src/database/pool.ts.
# Bancos remotos sempre usam TLS verificado; banco em localhost nao usa TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=5
# Opcional: outro certificado de CA, relativo a pasta backend ou absoluto.
# DATABASE_SSL_CA_PATH=certificates/prod-ca-2021.crt

# Opcional: em producao o cookie de sessao ja e sempre Secure.
# Use true em desenvolvimento servido por HTTPS, como o Codespaces.
# COOKIE_SECURE=true

# Opcional: quantos proxies confiaveis existem a frente da API (ex.: 1).
# Sem isso, X-Forwarded-For e ignorado e os limites por IP usam a conexao direta.
# TRUST_PROXY=1

# Opcional, para a API atras do proxy do Cloudflare Pages (functions/api/[[path]].ts).
# Com ela, so quem traz o mesmo valor (BACKEND_PROXY_SECRET no Cloudflare) chega as rotas,
# exceto /api/health, e o IP do navegador vem de CF-Connecting-IP. Nesse caso, TRUST_PROXY
# fica sem valor. Ao menos 32 caracteres aleatorios (ex.: openssl rand -hex 32).
# PROXY_SHARED_SECRET=

# Opcional: a limpeza de sessoes vencidas grava no banco e roda sozinha so em producao.
# Use true para liga-la fora de producao, ou false para desliga-la em producao.
# SESSION_CLEANUP_ENABLED=true

# Resend — preencher somente com credenciais autorizadas
RESEND_API_KEY=
RESEND_FROM=
# Provedor de e-mail: "resend" (padrao) ou "brevo". Com o Brevo, a chave (xkeysib-...) vai em
# BREVO_API_KEY e o remetente, confirmado no painel do Brevo (Senders), em EMAIL_FROM.
# EMAIL_PROVIDER=resend
# BREVO_API_KEY=
# EMAIL_FROM=SLM JUCESP <endereco-confirmado@dominio>
# Pepper da recuperacao de senha: ao menos 32 caracteres aleatorios (openssl rand -hex 32).
# Espacos e quebras de linha nas extremidades sao removidos antes do uso e nao contam no tamanho.
# Ausente: a recuperacao de senha fica desligada. Em producao, definido com menos de 32
# caracteres: a API nao inicia. Fora de producao, um valor curto e aceito (so para testes).
PASSWORD_RESET_PEPPER=

# Opcional: endereco publico do sistema (https). Com ele, a recuperacao de senha envia
# um link temporario; sem ele, envia o codigo de seis digitos.
# APP_PUBLIC_URL=

# Opcional: dominios de e-mail aceitos no cadastro, separados por virgula. Sem valor, nao
# ha restricao de dominio e a aprovacao administrativa continua obrigatoria.
# INSTITUTIONAL_EMAIL_DOMAINS=

# Chave de 32 bytes em base64 para cifrar o CPF dos passageiros (openssl rand -base64 32).
# Gere no proprio servidor; nunca reutilize a chave de teste nem a coloque no repositorio.
# Sem ela, o cadastro de passageiros responde 503 e nenhum CPF e gravado. Guarde-a fora do
# banco e dos backups: sem a chave, os CPFs gravados nao podem ser lidos.
# PASSENGER_DATA_KEY=

# Controle de Demandas: gera as ocorrências recorrentes e os alertas de prazo. Sem valor, so roda em producao.
# DEMANDS_WORKER_ENABLED=true

# ---------------------------------------------------------------------------
# Comunicações automáticas. Veja docs/INTEGRACOES_E_AUTOMACOES.md.
# Tudo desligado por padrao. Sem estes valores, as solicitacoes funcionam normalmente, e cada
# comunicacao fica registrada como "nao configurada", sem envio.
# ---------------------------------------------------------------------------
# Processa as filas. Sem valor, so roda em producao.
# INTEGRATIONS_WORKER_ENABLED=true

# Autoriza o envio automatico pelo Resend, alem de RESEND_API_KEY e RESEND_FROM.
# NOTIFICATION_EMAILS_ENABLED=true

# Opcional: enderecos autorizados, separados por virgula. Nao ha valor padrao.
# EMAIL_INTERNAL_TO_MAINTENANCE=
# EMAIL_INTERNAL_TO_FLEET=
# EMAIL_INTERNAL_TO_FLIGHTS=
# EMAIL_INTERNAL_TO_WAREHOUSE=
# EMAIL_INTERNAL_TO_SYSTEM=
# EMAIL_CC_MAINTENANCE=
# EMAIL_CC_FLEET=
# EMAIL_CC_FLIGHTS=
# EMAIL_CC_WAREHOUSE=

# Cota diaria do servico de e-mail (UTC). Use o limite contratado no Resend, ou menor: o sistema
# nao presume nenhum valor. Sem EMAIL_DAILY_LIMIT, as notificacoes nao saem pelo Resend.
# A reserva e da recuperacao de senha: as notificacoes nunca a usam. Padrao: 20% do limite.
# EMAIL_DAILY_LIMIT=
# EMAIL_RECOVERY_DAILY_RESERVE=
# Avisos administrativos equivalentes dentro desta janela viram uma mensagem so. 0 desliga. Padrao: 30.
# EMAIL_ADMIN_GROUP_MINUTES=30

# Lista de destinatarios permitidos para os testes reais (homologacao). So enderecos EXATOS, separados
# por virgula: dominio inteiro (@dominio) e curinga sao recusados. Sem a lista, nenhum e-mail real sai,
# nem a recuperacao de senha. A restricao so e desligada com EMAIL_RECIPIENT_RESTRICTION=off, depois
# da homologacao e com autorizacao.
# EMAIL_RECIPIENT_ALLOWLIST=
# EMAIL_RECIPIENT_RESTRICTION=test

# Opcional: dias sem andamento para gerar o lembrete a equipe. Sem valor, nao ha lembrete.
# NOTIFICATION_PENDING_DAYS=

# Anexos: pasta absoluta, fora da pasta do projeto (a API recusa uma pasta dentro dele), com
# permissao 700 e backup proprio (npm run backup:attachments). Sem ela, o envio de documentos
# fica indisponivel. Depende da decisao da TI sobre o armazenamento.
# ATTACHMENTS_DIR=/var/lib/slm/anexos

# Onde ficam os anexos: "local" (padrao; usa ATTACHMENTS_DIR), "supabase" (bucket privado do
# Supabase Storage) ou "sharepoint" (biblioteca do SharePoint institucional pelo Microsoft Graph).
# Com "supabase" ou "sharepoint" incompleto, os anexos ficam indisponiveis (503): nunca ha volta
# automatica para o disco local. Ver docs/ARMAZENAMENTO_SUPABASE.md e docs/ARMAZENAMENTO_SHAREPOINT.md.
# ATTACHMENTS_STORAGE=local
#
# Somente com ATTACHMENTS_STORAGE=supabase. Chave SECRETA (sb_secret_... ou a antiga service_role),
# nunca a publishable/anon. O bucket precisa ser privado: a API recusa bucket publico.
# SUPABASE_URL=https://abcdefgh.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=slm-anexos
#
# Somente com ATTACHMENTS_STORAGE=sharepoint. Aplicativo registrado pela TI no Entra ID, com a
# permissao de aplicativo Sites.Selected concedida apenas ao site da biblioteca.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# Use UM dos dois: segredo do aplicativo OU certificado (preferido em producao).
# GRAPH_CLIENT_SECRET=
# GRAPH_CERTIFICATE_PRIVATE_KEY=
# GRAPH_CERTIFICATE_THUMBPRINT=
# SHAREPOINT_DRIVE_ID=
# SHAREPOINT_ROOT_FOLDER=SLM-Anexos

# Monitoramento: registra a disponibilidade dos servicos a cada minuto. Grava no banco.
# MONITORING_ENABLED=true

# Registro das copias, gravado por scripts/backup-database.cjs e scripts/verify-backup.cjs.
# BACKUP_LOG_PATH=/var/lib/slm/backups/registro.jsonl
