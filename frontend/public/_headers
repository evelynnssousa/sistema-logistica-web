# Cloudflare Pages: cabeçalhos das telas publicadas. São os mesmos do `vite preview`
# (frontend/vite.config.ts), com os quais os testes de navegador rodam a versão compilada.
# Não valem para /api/*: as respostas da API trazem os cabeçalhos do próprio backend (helmet).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'

# Arquivos com resumo no nome: o conteúdo nunca muda para o mesmo endereço.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O service worker é conferido a cada abertura, para a versão nova chegar logo.
/sw.js
  Cache-Control: no-cache
